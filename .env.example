# Django settings (loaded by django-environ; values also work as exported
# environment variables). Copy this file to `.env` — it is git-ignored.

# REQUIRED in production — replace with a long random string. Avoid `$` here:
# docker compose interpolates `$` in .env values. The settings.py fallback key
# is insecure and exists only so a bare checkout boots with no .env at all.
SECRET_KEY=django-insecure-REPLACE-ME-with-a-long-random-string

# Never True in production.
DEBUG=True

# Comma-separated list of hostnames allowed to serve the site.
ALLOWED_HOSTS=

# Unset (or commented out) = SQLite at the repo root's db.sqlite3.
# The value below points at the `db` service defined in compose.yaml — the
# POSTGRES_* values are shared by both, so they always match by construction.
DATABASE_URL=postgres://school:school@localhost:5432/school

# PostgreSQL container configuration (compose.yaml). Comment out DATABASE_URL
# above to ignore Postgres entirely and stay on SQLite.
POSTGRES_USER=school
POSTGRES_PASSWORD=school
POSTGRES_DB=school
POSTGRES_PORT=5432
